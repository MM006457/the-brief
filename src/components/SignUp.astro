---
// Email sign-up band. Sends the email to /api/subscribe, which adds it to Beehiiv.
---
<section class="signup" id="signup">
  <div class="in grid">
    <div>
      <h2>Five minutes. Every Wednesday.</h2>
      <p>Written by two Warwick Business School students for everyone applying, interviewing or just trying to keep up.</p>
    </div>
    <form id="signup-form" novalidate>
      <label for="signup-email" class="sr-only">Email address</label>
      <input id="signup-email" name="email" type="email" required placeholder="you@university.ac.uk" autocomplete="email" />
      <!-- Hidden from people; catches spam bots -->
      <input class="hp" id="signup-website" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="btn" id="signup-btn" type="submit">Subscribe</button>
      <p class="fine" id="signup-msg" role="status">Free. Unsubscribe any time.</p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("signup-form") as HTMLFormElement;
  const email = document.getElementById("signup-email") as HTMLInputElement;
  const website = document.getElementById("signup-website") as HTMLInputElement;
  const btn = document.getElementById("signup-btn") as HTMLButtonElement;
  const msg = document.getElementById("signup-msg")!;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!email.value.trim()) { msg.textContent = "Enter your email to subscribe."; email.focus(); return; }
    btn.disabled = true;
    btn.textContent = "Subscribing…";
    msg.dataset.state = "";
    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email.value, website: website.value }),
      });
      const data = await res.json();
      msg.textContent = data.message;
      msg.dataset.state = data.ok ? "ok" : "error";
      if (data.ok) { form.reset(); btn.textContent = "Subscribed"; return; }
    } catch {
      msg.textContent = "We couldn't sign you up just now. Please try again in a minute.";
      msg.dataset.state = "error";
    }
    btn.disabled = false;
    btn.textContent = "Subscribe";
  });
</script>

<style>
  .signup { background: var(--band); color: var(--band-ink); }
  .grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px; align-items: center; padding-block: 52px;
  }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; gap: 20px; } }
  h2 { font: 800 clamp(28px, 4vw, 40px)/1.1 var(--f-display); margin: 0 0 10px; letter-spacing: -0.02em; }
  p { margin: 0; opacity: 0.82; }
  form { display: flex; gap: 10px; flex-wrap: wrap; }
  input {
    flex: 1 1 220px; min-width: 0; font: 400 16px var(--f-body); padding: 13px 14px; border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.25); background: rgba(255, 255, 255, 0.08); color: var(--band-ink);
  }
  input::placeholder { color: var(--band-ink); opacity: 0.55; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .btn { padding: 14px 18px; background: var(--band-accent); color: #2b1a40; }
  .btn:disabled { opacity: 0.7; cursor: default; }
  .fine { width: 100%; font-size: 13px; opacity: 0.75; margin-top: 4px; }
  .fine[data-state="ok"] { opacity: 1; color: #7fe0ad; font-weight: 600; }
  .fine[data-state="error"] { opacity: 1; color: #ffb3a6; }
</style>
