---
// Homepage. Rendered on request (not at build time) so new Beehiiv issues appear automatically.
export const prerender = false;
import Base from "../layouts/Base.astro";
import AskForm from "../components/AskForm.astro";
import SignUp from "../components/SignUp.astro";
import { getIssues, issueUrl, formatDate, pad } from "../lib/beehiiv";
import { FEED_REFRESH_SECONDS } from "../data/site";

Astro.response.headers.set("Cache-Control", `public, s-maxage=${FEED_REFRESH_SECONDS}, stale-while-revalidate=86400`);

const issues = await getIssues();
const latest = issues[0];
const url = latest ? issueUrl(latest) : "/issues/";
---
<Base>
  {latest ? (
    <section class="hero" id="latest">
      <div class="in grid">
        <div>
          <div class="eyebrow">
            <span class="label">Latest · Issue {pad(latest.number)}</span>
            <span>{formatDate(latest.date)}</span>
            <span>{latest.readTime} min read</span>
          </div>
          <h1>{latest.title}</h1>
          {latest.summary && <p class="deck">{latest.summary}</p>}
          <div class="cta">
            <a class="btn" href={url}>Read Issue {pad(latest.number)}</a>
            <a class="ghost" href="/issues/">All issues →</a>
          </div>
        </div>
        {latest.stories.length > 0 && (
          <aside class="index" aria-label="In this issue">
            <h2 class="label muted">In this issue</h2>
            <ol>
              {latest.stories.map((s) => (
                <li><a href={`${url}#${s.anchor}`}><span class="label">{s.section}</span><span class="t">{s.title}</span></a></li>
              ))}
            </ol>
          </aside>
        )}
      </div>
    </section>
  ) : (
    <section class="hero" id="latest">
      <div class="in empty">
        <span class="label">Coming soon</span>
        <h1>Issue 01 lands this week</h1>
        <p class="deck">What every business student should know this week, with what to say about it in your next interview. Subscribe and it arrives in your inbox.</p>
        <div class="cta"><a class="btn" href="#signup">Subscribe free</a></div>
      </div>
    </section>
  )}

  {latest && latest.stories.length > 0 && (
    <section class="desks" id="desks">
      <div class="in">
        <h2 class="h2">The desks</h2>
        <p class="sub">Every Monday. Each story ends with what it means for you.</p>
        <div class="cards">
          {latest.stories.slice(0, 4).map((s) => (
            <a class="card" href={`${url}#${s.anchor}`}>
              <span class="label">{s.section}</span>
              <h3>{s.title}</h3>
              {s.blurb && <p>{s.blurb}</p>}
              <span class="meta">Issue {pad(latest.number)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <AskForm />
  <SignUp />
</Base>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 48px; padding-block: 56px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; gap: 32px; padding-block: 36px; } }
  .empty { padding-block: 64px; }
  .eyebrow { display: flex; gap: 14px; flex-wrap: wrap; color: var(--muted); font-size: 14px; align-items: baseline; }
  h1 { font: 800 clamp(36px, 5.6vw, 60px)/1.04 var(--f-display); letter-spacing: -0.03em; margin: 18px 0; text-wrap: balance; max-width: 20ch; }
  .deck { font-size: 20px; line-height: 1.5; color: var(--muted); margin: 0 0 28px; max-width: 56ch; }
  .cta { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .ghost { font-weight: 600; font-size: 14px; color: var(--accent); text-decoration: none; }
  .index { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); padding: 22px; align-self: start; }
  .muted { color: var(--muted); margin: 0 0 6px; }
  .index ol { list-style: none; margin: 0; padding: 0; }
  .index li a { display: block; padding: 14px 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .index li:last-child a { border-bottom: 0; padding-bottom: 2px; }
  .index .label { display: block; margin-bottom: 6px; }
  .t { font: 600 17px/1.35 var(--f-display); }
  .index a:hover .t { color: var(--accent); }
  .desks { border-top: 1px solid var(--rule); }
  .desks .in { padding-block: 48px; }
  .h2 { font: 800 30px/1.2 var(--f-display); letter-spacing: -0.02em; margin: 0 0 6px; }
  .sub { color: var(--muted); margin: 0 0 24px; }
  .cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 960px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .cards { grid-template-columns: 1fr; } }
  .card { display: flex; flex-direction: column; gap: 10px; padding-top: 16px; border-top: 3px solid var(--ink); text-decoration: none; }
  .card h3 { font: 700 21px/1.25 var(--f-display); margin: 0; text-wrap: balance; }
  .card p { margin: 0; color: var(--muted); font-size: 15px; }
  .meta { margin-top: auto; color: var(--muted); font-size: 13px; font-weight: 500; }
  .card:hover h3 { color: var(--accent); }
</style>
